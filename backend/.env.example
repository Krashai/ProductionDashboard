# Copy to .env (git-ignored) and fill in a real value before running
# `docker compose up`. No default is hardcoded anywhere in the app —
# see app/api/deps.py:require_admin_token and app/main.py:create_app.
#
# Generate one with e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
