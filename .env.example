# WebSocket URL for the live PLC gateway backend (see backend/docker-compose.yml
# — the dashboard-plc-backend container publishes port 8001, NOT 8000).
#
# This is inlined into the JS bundle at build time and opened directly by the
# browser — it is NOT proxied through the Next.js server. If this frontend is
# reached through the office reverse proxy (see dashboard.conf on the proxy
# host, app served under /infrastructure), this must point at the proxy's
# office-facing address instead of the backend's own IP, since office
# machines (10.0.0.x) cannot reach the OT subnet (10.10.0.x) directly:
#   NEXT_PUBLIC_WS_URL=ws://10.0.0.211/infrastructure/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws

# Areas data source: "ws" (default, real backend) or "mock" (no backend
# needed — synthetic random data, useful for local UI-only development).
NEXT_PUBLIC_DATA_SOURCE=ws

# Subpath this build is served under when it sits behind a reverse proxy
# (see next.config.mjs). Leave unset/empty to serve from "/". Must match
# the location prefix configured for it in dashboard.conf on the proxy host,
# and the path segment used in NEXT_PUBLIC_WS_URL above.
BASE_PATH=/infrastructure
