# Build-time settings for the kiosk frontend (inlined by `next build` —
# rebuild the image after changing any of them).
#
# There is deliberately no WebSocket URL here: the browser connects
# same-origin to `${BASE_PATH}/ws` on whatever host served the page, and
# the Next.js server forwards it to the backend (see next.config.mjs). That
# is what lets one build work both through the office reverse proxy
# (10.0.0.211/infrastructure) and directly on the OT subnet
# (10.10.0.244:3002). A leftover NEXT_PUBLIC_WS_URL line is ignored.

# Areas data source: "ws" (default, real backend) or "mock" (no backend
# needed — synthetic random data, useful for local UI-only development).
NEXT_PUBLIC_DATA_SOURCE=ws

# Subpath this build is served under (see next.config.mjs). Must match the
# location prefix configured for it in dashboard.conf on the proxy host —
# and must stay set there, since the proxy routes "/" and "/_next/static/"
# to ProductionMonitor's LineGantt. Leave empty only for a proxy-less setup.
BASE_PATH=/infrastructure

# Where the Next.js server (not the browser) reaches the backend. Default:
# the backend container on the shared `proddash_internal` Docker network.
# BACKEND_INTERNAL_URL=http://dashboard-plc-backend:8001
